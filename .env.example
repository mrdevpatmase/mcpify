APP_URL=https://your-app.onrender.com

# Optional: persists proxy state (target URLs, api keys, ping status) to
# Upstash Redis so it survives redeploys/restarts. Without this, proxy
# state is in-memory only and is lost on every restart.
UPSTASH_REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Required for real encryption of secrets at rest (proxy api_key, OAuth
# client secrets/tokens stored in Redis). Without this set, the app falls
# back to a hardcoded key that's public in this repo's source - secrets
# get "encrypted" with a key anyone can read, i.e. no real protection.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# Optional: gates /metrics, /proxy/list, /admin/audit-log, and
# DELETE /admin/proxy/{id} behind an X-API-Key / Bearer header. Unset
# (the default) leaves these open - fine for local dev, not for a public
# deployment with data you care about.
ADMIN_API_KEY=

# Optional logging tuning. LOG_FORMAT=json (default) emits structured
# JSON logs suited to log aggregators; set LOG_FORMAT=text for readable
# local-dev output. LOG_LEVEL defaults to INFO.
LOG_FORMAT=json
LOG_LEVEL=INFO

# Required for signup/login/proxy-ownership. A Postgres connection string
# (Railway's own Postgres, Neon, or any provider). postgres:// / postgresql://
# are both fine - normalized automatically. Pooled connections (Neon's
# "-pooler" host, PgBouncer) work too; sslmode/channel_binding query
# params are handled automatically if present.
DATABASE_URL=

# Required for signup/login - signs the JWTs issued at /auth/login and
# /auth/signup. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating this invalidates every issued token immediately (all users
# get logged out).
JWT_SECRET_KEY=

# Optional: how long an issued JWT stays valid, in minutes. Defaults to
# 1440 (24 hours).
JWT_EXPIRE_MINUTES=1440

# Required for the GA4 traffic panel on /admin (GET /admin/analytics).
# GA_PROPERTY_ID is the numeric GA4 property id (Admin > Property Settings
# in Google Analytics, NOT the G-XXXX measurement id used by gtag.js).
GA_PROPERTY_ID=

# GA credentials - two ways to authenticate, only one is needed:
#
# 1. OAuth refresh token (use this if your Google Cloud org enforces
#    iam.disableServiceAccountKeyCreation, which blocks service account
#    JSON keys entirely). Obtained once via a local OAuth consent flow
#    (google-auth-oauthlib's InstalledAppFlow) using a Desktop-app OAuth
#    client from Google Cloud Console > APIs & Services > Credentials,
#    with the account that has Viewer access on the GA4 property.
#    Refresh tokens don't expire unless revoked.
GA_OAUTH_CLIENT_ID=
GA_OAUTH_CLIENT_SECRET=
GA_OAUTH_REFRESH_TOKEN=
#
# 2. Service account JSON (simpler, if your org allows service account
#    keys) - the full downloaded key file content as one line, for a
#    service account with Viewer access on the GA4 property.
GOOGLE_ANALYTICS_CREDENTIALS_JSON=

# Optional: stores newly-uploaded ad images/videos on Cloudinary instead
# of as raw bytes in Postgres. Get these from your Cloudinary dashboard
# (Settings > API Keys) after signing up at cloudinary.com - the free
# tier is enough for this. Without all three set, ad uploads fall back
# to the old behavior (stored directly in the ads table) - existing ads
# created that way keep working either way, nothing migrates retroactively.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
